      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Onboarding-Modul erlaubt Ihnen, einen Einführungsprozess wie diesen aufzubauen."
          }
        },
        "en" : {
          "stringUnit" : {
