    "INTERESTING_MODULES_AREA4_DESCRIPTION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem HealthKit-Data-Source-Modul können Sie Daten aus HealthKit abrufen und z.B. in FHIR-Strukturen transformieren."
