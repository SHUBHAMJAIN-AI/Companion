    "ACCOUNT_SETUP_DESCRIPTION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können sich in Ihr bestehendes Konto einloggen. Oder erstellen Sie ein neues, falls Sie noch keins haben."
          }
        },
