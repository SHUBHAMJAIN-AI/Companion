    "INTERESTING_MODULES_AREA2_DESCRIPTION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Applikation nutzt HL7 FHIR als einheitlichen Standard zur Strukturierung der erfassten Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
